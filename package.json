{
  "name": "anything.sh",
  "version": "0.1.0",
  "author": "XertroV",
  "license": "Unlicense",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"bunx tailwindcss -i ./src/index.css -o ./src/output.css --watch\" \"bun --hot src/index.ts\"",
    "build": "bunx tailwindcss -i ./src/index.css -o ./src/output.css && bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*' && bun run generate-scripts",
    "generate-scripts": "bun scripts/generate-scripts.ts",
    "start": "NODE_ENV=production bun src/index.ts"
  },
  "dependencies": {
    "lucide-react": "^0.563.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "figlet": "^1.10.0",
    "postcss": "^8.5.6",
    "tailwindcss": "3"
  }
}
